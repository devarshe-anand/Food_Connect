# Copy to database/.env. Replace every change-me value before use.
POSTGRES_DB=foodconnect
POSTGRES_USER=foodconnect_admin
POSTGRES_PASSWORD=change-me-use-a-long-random-secret
APP_DB_USER=foodconnect_app
APP_DB_PASSWORD=change-me-use-a-different-long-random-secret

# Published only on loopback by default; change only for a trusted private network.
DB_BIND_ADDRESS=127.0.0.1
DB_PORT=5432

# Optional overrides for image updates.
POSTGIS_IMAGE=postgis/postgis:17-3.5
