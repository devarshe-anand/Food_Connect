generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_account_status")
}

enum PlatformRole {
  USER
  ADMIN

  @@map("platform_role")
}

enum OrganizationType {
  RESTAURANT
  HOTEL
  EVENT_ORGANIZER
  NGO

  @@map("organization_type")
}

enum OrganizationVerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("organization_verification_status")
}

enum OrganizationOperationalStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("organization_operational_status")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER

  @@map("membership_role")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED

  @@map("membership_status")
}

enum OrganizationDocumentType {
  BUSINESS_REGISTRATION
  IDENTITY
  FOOD_SAFETY
  NGO_REGISTRATION
  OTHER

  @@map("organization_document_type")
}

enum DocumentVerificationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("document_verification_status")
}

enum DonationCategory {
  MEALS
  BAKERY
  PRODUCE
  DAIRY
  PACKAGED
  OTHER

  @@map("donation_category")
}

enum DonationUnit {
  PORTION
  KG
  LITER
  BOX
  ITEM

  @@map("donation_unit")
}

enum DonationStatus {
  AVAILABLE
  CLAIMED
  COLLECTED
  COMPLETED
  CANCELLED
  EXPIRED

  @@map("donation_status")
}

enum DonationClaimStatus {
  NOTIFIED
  ACCEPTED
  LOST
  WITHDRAWN

  @@map("donation_claim_status")
}

enum NotificationType {
  DONATION_AVAILABLE
  DONATION_CLAIMED
  DONATION_UNAVAILABLE
  HANDOVER_CONFIRMED
  DONATION_COMPLETED
  ORGANIZATION_STATUS

  @@map("notification_type")
}

enum HandoverConfirmationType {
  DONOR
  NGO

  @@map("handover_confirmation_type")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD

  @@map("outbox_status")
}

model User {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName              String               @map("full_name") @db.VarChar(200)
  email                 String               @db.VarChar(320)
  phoneNumber           String?              @map("phone_number") @db.VarChar(32)
  passwordHash          String               @map("password_hash") @db.VarChar(255)
  platformRole          PlatformRole         @default(USER) @map("platform_role")
  accountStatus         UserAccountStatus    @default(PENDING) @map("account_status")
  emailVerified         Boolean              @default(false) @map("email_verified")
  phoneVerified         Boolean              @default(false) @map("phone_verified")
  lastLoginAt           DateTime?            @map("last_login_at") @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?            @map("deleted_at") @db.Timestamptz(6)
  memberships           OrganizationMember[]
  verifiedOrganizations Organization[]       @relation("OrganizationVerifier")
  reviewedDocuments     OrganizationDocument[] @relation("DocumentReviewer")
  notifications         Notification[]
  handoverConfirmations HandoverConfirmation[]
  auditLogs             AuditLog[]
  refreshTokens         RefreshToken[]

  @@map("users")
}

model Organization {
  id                 String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String                         @db.VarChar(200)
  type               OrganizationType
  registrationNumber String?                        @map("registration_number") @db.VarChar(100)
  registrationCountry String?                        @map("registration_country") @db.Char(2)
  taxIdentifier      String?                        @map("tax_identifier") @db.VarChar(100)
  addressLine1       String                         @map("address_line_1") @db.VarChar(200)
  addressLine2       String?                        @map("address_line_2") @db.VarChar(200)
  locality           String                         @db.VarChar(120)
  administrativeArea String?                        @map("administrative_area") @db.VarChar(120)
  postalCode         String?                        @map("postal_code") @db.VarChar(24)
  countryCode        String                         @map("country_code") @db.Char(2)
  contactEmail       String?                        @map("contact_email") @db.VarChar(320)
  contactPhone       String?                        @map("contact_phone") @db.VarChar(32)
  location           Unsupported("geography(Point,4326)")?
  verificationStatus OrganizationVerificationStatus @default(PENDING) @map("verification_status")
  operationalStatus  OrganizationOperationalStatus  @default(ACTIVE) @map("operational_status")
  logoStoragePath    String?                        @map("logo_storage_path")
  verifiedAt         DateTime?                      @map("verified_at") @db.Timestamptz(6)
  verifiedByUserId   String?                        @map("verified_by_user_id") @db.Uuid
  verificationNotes  String?                        @map("verification_notes")
  createdAt          DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                       @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?                      @map("deleted_at") @db.Timestamptz(6)
  memberships        OrganizationMember[]
  documents          OrganizationDocument[]
  donations          Donation[]                     @relation("DonorOrganization")
  acceptedDonations  Donation[]                     @relation("AcceptedOrganization")
  claims             DonationClaim[]
  notifications      Notification[]
  handoverConfirmations HandoverConfirmation[]
  verifiedBy         User?                          @relation("OrganizationVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@map("organizations")
}

model OrganizationMember {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  role           MembershipRole  @default(MEMBER)
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, organizationId])
  @@map("organization_members")
}

model OrganizationDocument {
  id                 String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                       @map("organization_id") @db.Uuid
  documentType      OrganizationDocumentType     @map("document_type")
  storagePath       String                       @map("storage_path")
  verificationStatus DocumentVerificationStatus  @default(PENDING) @map("verification_status")
  uploadedAt        DateTime                     @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  reviewedAt        DateTime?                    @map("reviewed_at") @db.Timestamptz(6)
  reviewedByUserId  String?                      @map("reviewed_by_user_id") @db.Uuid
  reviewerNotes     String?                      @map("reviewer_notes")
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewer          User?                        @relation("DocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@map("organization_documents")
}

model Donation {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donorOrganizationId    String                  @map("donor_organization_id") @db.Uuid
  acceptedByOrganizationId String?               @map("accepted_by_organization_id") @db.Uuid
  title                  String                  @db.VarChar(200)
  description            String?
  category               DonationCategory
  quantity               Decimal                 @db.Decimal(12, 3)
  unit                   DonationUnit
  preparedAt             DateTime?               @map("prepared_at") @db.Timestamptz(6)
  expiresAt              DateTime                @map("expires_at") @db.Timestamptz(6)
  pickupDeadline         DateTime                @map("pickup_deadline") @db.Timestamptz(6)
  pickupAddress          String                  @map("pickup_address")
  pickupLocation         Unsupported("geography(Point,4326)") @map("pickup_location")
  status                 DonationStatus          @default(AVAILABLE)
  imageStoragePath       String?                 @map("image_storage_path")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  cancelledAt            DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  completedAt            DateTime?               @map("completed_at") @db.Timestamptz(6)
  donorOrganization      Organization            @relation("DonorOrganization", fields: [donorOrganizationId], references: [id], onDelete: Restrict)
  acceptedByOrganization Organization?           @relation("AcceptedOrganization", fields: [acceptedByOrganizationId], references: [id], onDelete: Restrict)
  claims                 DonationClaim[]
  notifications          Notification[]
  handoverConfirmations  HandoverConfirmation[]

  @@index([donorOrganizationId, createdAt])
  @@map("donations")
}

model DonationClaim {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donationId       String             @map("donation_id") @db.Uuid
  ngoOrganizationId String            @map("ngo_organization_id") @db.Uuid
  status           DonationClaimStatus @default(NOTIFIED)
  notifiedAt       DateTime           @default(now()) @map("notified_at") @db.Timestamptz(6)
  acceptedAt       DateTime?          @map("accepted_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  donation         Donation           @relation(fields: [donationId], references: [id], onDelete: Cascade)
  ngoOrganization Organization       @relation(fields: [ngoOrganizationId], references: [id], onDelete: Restrict)

  @@unique([donationId, ngoOrganizationId])
  @@index([ngoOrganizationId, status, notifiedAt])
  @@map("donation_claims")
}

model Notification {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId         String?          @map("recipient_user_id") @db.Uuid
  recipientOrganizationId String?          @map("recipient_organization_id") @db.Uuid
  donationId              String?          @map("donation_id") @db.Uuid
  notificationType        NotificationType @map("notification_type")
  title                   String           @db.VarChar(200)
  message                 String
  payload                 Json              @default("{}") @db.JsonB
  idempotencyKey          String           @unique @map("idempotency_key") @db.VarChar(255)
  readAt                  DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  recipientUser           User?            @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientOrganization   Organization?    @relation(fields: [recipientOrganizationId], references: [id], onDelete: Cascade)
  donation                Donation?         @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model HandoverConfirmation {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donationId           String                    @map("donation_id") @db.Uuid
  organizationId       String                    @map("organization_id") @db.Uuid
  confirmedByUserId    String                    @map("confirmed_by_user_id") @db.Uuid
  confirmationType     HandoverConfirmationType  @map("confirmation_type")
  evidenceStoragePath  String?                   @map("evidence_storage_path")
  confirmedAt          DateTime                  @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  donation             Donation                  @relation(fields: [donationId], references: [id], onDelete: Cascade)
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  confirmedBy          User                      @relation(fields: [confirmedByUserId], references: [id], onDelete: Restrict)

  @@unique([donationId, confirmationType])
  @@map("handover_confirmations")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType   String   @map("actor_type") @db.VarChar(10)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String   @map("entity_id") @db.Uuid
  oldValues   Json?    @map("old_values") @db.JsonB
  newValues   Json?    @map("new_values") @db.JsonB
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model NotificationOutbox {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType      String      @map("event_type") @db.VarChar(100)
  aggregateType  String      @map("aggregate_type") @db.VarChar(100)
  aggregateId    String      @map("aggregate_id") @db.Uuid
  idempotencyKey String      @unique @map("idempotency_key") @db.VarChar(255)
  payload        Json        @db.JsonB
  status         OutboxStatus @default(PENDING)
  attempts       Int         @default(0)
  maxAttempts    Int         @default(8) @map("max_attempts")
  availableAt    DateTime    @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedBy       String?     @map("locked_by") @db.Uuid
  leaseExpiresAt DateTime?   @map("lease_expires_at") @db.Timestamptz(6)
  processedAt    DateTime?   @map("processed_at") @db.Timestamptz(6)
  lastError      String?     @map("last_error")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("notification_outbox")
}

model RefreshToken {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?  @map("replaced_by_token_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy       RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacedTokens   RefreshToken[] @relation("RefreshTokenRotation")

  @@map("refresh_tokens")
}
